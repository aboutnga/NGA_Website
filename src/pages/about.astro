---
import Base from '../layouts/BaseLayout.astro';
const colleges=['Johns Hopkins','Northwestern','UPenn','Cornell','Dartmouth','UC Berkeley','UCLA','Vanderbilt','U. Michigan','USC','UC San Diego','Boston College','Wisconsin–Madison','UIUC','Ohio State','Boston University','Northeastern','UC Santa Barbara','UC Irvine','UC Davis','University of Washington','Purdue','UC Riverside','Case Western','UC Merced','Michigan State','Indiana Bloomington','Drexel','Pepperdine','UC Santa Cruz','Loyola Marymount','Amherst','Swarthmore','Pomona College','Cal Poly Pomona','CSULB','CSUN','Duke Kunshan','and more'];
---
<Base title="About NGA | Next Generation Advocates" active="/about"><section class="page-banner"><div class="container"><h1>About NGA</h1><p>Mentor-guided education that helps students think deeply, communicate clearly, and contribute meaningfully.</p></div></section>
<section class="section"><div class="container"><h2 class="section-title">Our Mission</h2><div class="rule"></div><p class="lede">Next Generation Advocates (NGA) is a 501(c)(3) nonprofit youth foundation that empowers young people through engagement, education, and experience. NGA promotes civic engagement and artistic expression while providing mentor-guided opportunities in research, communication, community impact, college readiness, and career exploration. Through these experiences, students build the knowledge, confidence, and practical skills needed to contribute meaningfully to their communities and thrive in an evolving society.</p><div class="grid grid-3"><div class="colored-title">Engage</div><div class="colored-title">Educate</div><div class="colored-title">Experience</div></div></div></section>
<section class="section soft" id="impact"><div class="container"><h2 class="section-title">Impact & Outcomes</h2><div class="rule"></div><section class="statbar"><div class="stat"><strong>2018</strong><span>Founded</span></div><div class="stat"><strong>120,000+</strong><span>Student Project Hours</span></div><div class="stat"><strong>24</strong><span>Projects</span></div><div class="stat"><strong>8</strong><span>Mentors Hosted</span></div></section></div></section>
<section class="section sponsors-section"><div class="container"><h2 class="section-title">Sponsors & Community Partners</h2><div class="rule"></div><div class="sponsor-grid"><div class="sponsor-card"><img class="boa-stacked" src="/images/sponsors/bank-of-america-stacked.png?v=2" alt="Bank of America"/></div><div class="sponsor-card"><img src="/images/sponsors/cbs-television-studios.png" alt="CBS Television Studios"/></div></div></div></section>
<section class="section"><div class="container"><h2 class="section-title">Selected College Acceptances</h2><div class="rule"></div><div class="college-list">{colleges.map(c=><span>{c}</span>)}</div></div></section>
<section class="section ivory"><div class="container founder"><div class="founder-photo"><img src="/images/brand/nga-circle.png" alt="Next Generation Advocates logo"/></div><div><span class="eyebrow">Founder’s Message</span><h2>Helping students build lasting confidence and capability</h2><p>NGA helps students discover their potential, think independently, communicate with the world, and create meaningful results. Our goal extends beyond building activities for college admission: we want each student’s knowledge and experience to become a foundation for college, career, and responsible participation in society.</p><strong>Founder, Helen Kim</strong></div></div></section>
<style>.sponsors-section{background:var(--ivory)}.sponsor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;max-width:820px;margin:0 auto}.sponsor-card{height:190px;display:grid;place-items:center;padding:28px;background:#fff;border:1px solid var(--line);box-shadow:0 8px 25px rgba(16,42,76,.04)}.sponsor-card>img{width:auto;max-width:82%;max-height:115px;object-fit:contain}.sponsor-card>.boa-stacked{max-height:138px}.college-list{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}.college-list span{padding:8px 12px;background:var(--ivory);border:1px solid var(--line)}.college-list span:last-child{color:#fff;background:var(--burgundy);border-color:var(--burgundy);font-weight:700}.founder{display:grid;grid-template-columns:320px 1fr;gap:48px;align-items:center}.founder-photo{aspect-ratio:4/5;display:grid;place-items:center;padding:44px;background:var(--blush)}.founder-photo img{width:100%}.founder h2{font-family:var(--serif);font-size:2.2rem}@media(max-width:760px){.sponsor-grid,.founder{grid-template-columns:1fr}.sponsor-card{height:175px}.founder-photo{max-width:320px}}</style>
</Base>
