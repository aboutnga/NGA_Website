---
import Base from '../layouts/BaseLayout.astro';
const mentors=[
  ['Robert Ahn','KAFLA President','robert-ahn.jpg'],
  ['Stella Lee','BOA Senior VP','stella-lee.jpg'],
  ['Steve Kang','LA City Commissioner','steve-kang.jpg'],
  ['Irene Lee','LA County DA','irene-lee.jpg'],
  ['Eric Kim','CBS Executive VP','eric-kim.jpg'],
  ['Pilseong Kim','DDS, UCLA Lecturer','pilseong-kim.jpg'],
  ['Helen Kim','College Consultant','helen-kim.jpg'],
  ['Rachel Rodriguez','LAPD Cmdg. Officer','rachel-rodriguez.jpg']
];
---
<Base title="Meet a Mentor | NGA" active="/programs">
  <section class="hero"><div class="hero-copy"><h1>Meet a Mentor</h1><p>Professional journeys and real-world insight.</p></div><div class="hero-media"><img src="/images/generated/research-mentoring-hero.png" alt="Students learning with a professional mentor"/></div></section>
  <section class="section"><div class="container"><h2 class="section-title">Our Mentors</h2><div class="rule"></div><div class="mentor-grid">{mentors.map(([name,title,img])=><article><img class="portrait" src={`/images/mentors/${img}`} alt={`${name}, ${title}`}/><h3>{name}</h3><p>{title}</p></article>)}</div><div class="registration-bar"><a class="registration" href="https://forms.gle/CQ1QoJxqKQUTeH3v7" target="_blank">Meet a Mentor Registration</a></div></div></section>
  <style>.mentor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px 28px;text-align:center}.portrait{width:100%;aspect-ratio:1;border-radius:50%;object-fit:cover;background:var(--blue-soft)}.mentor-grid h3{margin:15px 0 0;font-family:var(--serif);font-size:1.3rem}.mentor-grid p{margin:3px 0;color:var(--muted)}.registration-bar{display:grid;place-items:center;margin-top:48px;padding:34px;background:var(--burgundy)}.registration{width:min(650px,100%);min-height:88px;display:grid;place-items:center;padding:16px;color:var(--navy);background:#fff;text-align:center;text-decoration:none;font-family:var(--serif);font-size:1.75rem;font-weight:700;box-shadow:0 8px 20px rgba(16,42,76,.14)}@media(max-width:520px){.mentor-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 10px}.mentor-grid h3{margin-top:10px;font-size:1rem;line-height:1.2}.mentor-grid p{font-size:.78rem;line-height:1.35}.registration-bar{padding:22px}.registration{min-height:76px;font-size:1.4rem}}</style>
</Base>
