---
import Base from '../layouts/BaseLayout.astro';
const mentors=[
  ['Robert Ahn','KAFLA President','robert-ahn-ref-v2.png'],
  ['Stella Lee','BOA Senior VP','stella-lee-ref-v2.png'],
  ['Steve Kang','LA City Commissioner','steve-kang-ref-v2.png'],
  ['Irene Lee','LA County DA','irene-lee-ref-v2.png'],
  ['Eric Kim','CBS Executive VP','eric-kim-ref-v2.png'],
  ['Pilseong Kim','DDS, UCLA Lecturer','pilseong-kim-ref-v2.png'],
  ['Helen Kim','College Consultant','helen-kim-ref-v2.png'],
  ['Rachel Rodriguez','LAPD Cmdg. Officer','rachel-rodriguez-ref-v2.png']
];
---
<Base title="Meet a Mentor | NGA" active="/programs">
  <section class="hero"><div class="hero-copy"><h1>Meet a Mentor</h1><p>Professional journeys and real-world insight.</p></div><div class="hero-media"><img src="/images/generated/meet-a-mentor-hero-blurred-v2.png" alt="Students gathered with professional mentors at a Meet a Mentor event"/></div></section>
  <section class="section"><div class="container"><h2 class="section-title">Our Mentors</h2><div class="rule"></div><div class="mentor-grid">{mentors.map(([name,title,img])=><article><div class="portrait-frame"><div class="portrait-crop"><img class="portrait" src={`/images/mentors/${img}`} alt={`${name}, ${title}`}/></div></div><h3>{name}</h3><p>{title}</p></article>)}</div><div class="registration-bar"><a class="registration" href="https://forms.gle/CQ1QoJxqKQUTeH3v7" target="_blank">Meet a Mentor Registration</a></div></div></section>
  <style>
    .mentor-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:34px 28px;text-align:center}
    .mentor-grid article{flex:0 1 calc((100% - 84px)/4)}
    .portrait-frame,.portrait-crop{width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden}
    .portrait{width:100%;height:100%;border-radius:50%;object-fit:cover}
    .mentor-grid h3{margin:15px 0 0;font-family:var(--serif);font-size:1.3rem}
    .mentor-grid p{margin:3px 0;color:var(--muted)}
    .registration-bar{display:grid;place-items:center;margin-top:48px;padding:34px;background:var(--burgundy)}
    .registration{width:min(650px,100%);min-height:88px;display:grid;place-items:center;padding:16px;color:var(--navy);background:#fff;text-align:center;text-decoration:none;font-family:var(--serif);font-size:1.75rem;font-weight:700;box-shadow:0 8px 20px rgba(16,42,76,.14)}
    @media(max-width:700px){
      .mentor-grid{gap:24px 10px}
      .mentor-grid article{flex-basis:calc((100% - 20px)/3)}
      .mentor-grid h3{margin-top:10px;font-size:1rem;line-height:1.2}
      .mentor-grid p{font-size:.78rem;line-height:1.35}
      .registration-bar{padding:22px}
      .registration{min-height:76px;font-size:1.4rem}
    }
  </style>
</Base>
