---
import Base from '../layouts/BaseLayout.astro';
---
<Base title="Student Showcase | NGA" active="/student-showcase"><section class="page-banner"><div class="container"><h1>Student Showcase</h1><p>Student work, ideas, and community impact—shared through NGA’s public channels.</p></div></section><section class="section"><div class="container"><h2 class="section-title">Instagram</h2><div class="rule"></div><div class="grid grid-3">{[1,2,3,4,5,6,7,8,9].map((n)=><a class="social-card" href="https://www.instagram.com/next.generation.advocates/" target="_blank"><div>LIVE INSTAGRAM POST {n}</div><p>Post title and caption will appear here…</p></a>)}</div></div></section><section class="section soft"><div class="container"><h2 class="section-title">YouTube</h2><div class="rule"></div><div class="grid grid-3">{[1,2,3,4,5,6].map(n=><a class="video-card" href="https://www.youtube.com/@nextNGA" target="_blank"><div>▶</div><p>NGA video {n}</p></a>)}</div></div></section><style>.social-card,.video-card{text-decoration:none;background:#fff;border:1px solid var(--line)}.social-card>div{aspect-ratio:1;display:grid;place-items:center;background:var(--blush);font-size:.72rem}.social-card p,.video-card p{margin:0;padding:15px;font-weight:700}.video-card>div{aspect-ratio:16/9;display:grid;place-items:center;color:#fff;background:var(--navy);font-size:2rem}</style></Base>
