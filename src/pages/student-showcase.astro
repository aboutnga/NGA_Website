---
import Base from '../layouts/BaseLayout.astro';

const currentVideos = [
  ['3SJhqs9P4n8', '자녀를 성공시키려면, 세상 뉴스를 잡아라 #보통아이대학보내기'],
  ['oLcylhvT0MM', 'Weighted GPA와 Unweighted GPA 중 어떤 것이 더 중요할까요?'],
  ['iBpN4r3Kxlo', 'NGA 미국교육방송 — 삼박자교육 Ep. 2'],
  ['H-GS5qeRtlw', 'NGA 미국교육방송 — 삼박자교육 Ep. 1'],
  ['Ye7OVe5IBhg', 'Justin Lee — Youth Speaker']
];
---

<Base title="Student Showcase | NGA" active="/student-showcase">
  <section class="page-banner">
    <div class="container">
      <h1>Student Showcase</h1>
      <p>Student work, ideas, and community impact—updated through NGA’s public channels.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="panel-heading page-heading">
        <div><span class="eyebrow">Instagram</span><h2>Latest NGA Posts</h2></div>
        <a href="https://www.instagram.com/next.generation.advocates/" target="_blank" rel="noreferrer">Open Instagram →</a>
      </div>
      <p class="lede left-lede">New Instagram posts appear here automatically.</p>
      <article class="feed-panel instagram-panel">
        <iframe
          class="instagram-feed"
          src="https://www.instagram.com/next.generation.advocates/embed/"
          title="Latest posts from Next Generation Advocates on Instagram"
          loading="lazy"
          allowtransparency="true"
          scrolling="no"
        ></iframe>
      </article>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="panel-heading page-heading">
        <div><span class="eyebrow">YouTube</span><h2>Latest NGA Videos</h2></div>
        <a href="https://www.youtube.com/@nextNGA" target="_blank" rel="noreferrer">Open YouTube →</a>
      </div>
      <p id="youtube-status" class="lede left-lede" aria-live="polite">The newest videos appear first and update automatically.</p>

      <div id="youtube-grid" class="video-grid">
        {currentVideos.map(([id, title]) =>
          <a class="video-card" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noreferrer">
            <div class="thumbnail">
              <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
              <span class="play" aria-hidden="true">▶</span>
            </div>
            <h3>{title}</h3>
          </a>
        )}
        <a class="video-card channel-card" href="https://www.youtube.com/@nextNGA" target="_blank" rel="noreferrer">
          <div class="channel-mark" aria-hidden="true">▶</div>
          <h3>More videos from NGA</h3>
          <p>The next upload will appear here automatically.</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    const grid = document.querySelector('#youtube-grid');
    const status = document.querySelector('#youtube-status');

    const createVideoCard = (item) => {
      const link = document.createElement('a');
      link.className = 'video-card';
      link.href = item.url;
      link.target = '_blank';
      link.rel = 'noreferrer';

      const thumbnail = document.createElement('div');
      thumbnail.className = 'thumbnail';

      const image = document.createElement('img');
      image.src = item.thumbnail;
      image.alt = '';
      image.loading = 'lazy';

      const play = document.createElement('span');
      play.className = 'play';
      play.setAttribute('aria-hidden', 'true');
      play.textContent = '▶';

      const title = document.createElement('h3');
      title.textContent = item.title;

      thumbnail.append(image, play);
      link.append(thumbnail, title);
      return link;
    };

    fetch('/api/youtube-feed')
      .then((response) => {
        if (!response.ok) throw new Error('Feed unavailable');
        return response.json();
      })
      .then((data) => {
        if (!(grid instanceof HTMLElement) || !Array.isArray(data.items) || !data.items.length) return;
        grid.replaceChildren(...data.items.map(createVideoCard));

        if (data.items.length < 6) {
          const channel = document.createElement('a');
          channel.className = 'video-card channel-card';
          channel.href = 'https://www.youtube.com/@nextNGA';
          channel.target = '_blank';
          channel.rel = 'noreferrer';
          channel.innerHTML = '<div class="channel-mark" aria-hidden="true">▶</div><h3>More videos from NGA</h3><p>The next upload will appear here automatically.</p>';
          grid.append(channel);
        }
      })
      .catch(() => {
        if (status instanceof HTMLElement) status.textContent = 'Showing NGA’s current videos. New uploads will refresh automatically.';
      });
  </script>

  <style>
    .panel-heading{display:flex;align-items:center;justify-content:space-between;gap:20px}
    .page-heading h2{margin:2px 0 0;font-family:var(--serif);font-size:clamp(2rem,4vw,3rem);line-height:1.15}
    .panel-heading a{color:var(--burgundy);font-weight:700;text-decoration:none;white-space:nowrap}
    .left-lede{max-width:none;margin:8px 0 28px;text-align:left}
    .feed-panel{overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow)}
    .instagram-panel{width:100%}
    .instagram-feed{display:block;width:100%;height:960px;overflow:hidden;border:0;background:#fff}
    .video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
    .video-card{overflow:hidden;color:var(--ink);background:#fff;border:1px solid var(--line);box-shadow:0 8px 25px rgba(16,42,76,.05);text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}
    .video-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
    .video-card h3{margin:0;padding:17px 18px;font-family:var(--serif);font-size:1.08rem;line-height:1.35}
    .thumbnail{position:relative;aspect-ratio:16/9;overflow:hidden;background:var(--navy)}
    .thumbnail img{width:100%;height:100%;object-fit:cover}
    .play{position:absolute;top:50%;left:50%;width:52px;height:38px;display:grid;place-items:center;transform:translate(-50%,-50%);border-radius:10px;color:#fff;background:#e62117;font-size:1.15rem;box-shadow:0 5px 16px rgba(0,0,0,.28)}
    .channel-card{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px;text-align:center;color:#fff;background:var(--navy)}
    .channel-card h3{padding:15px 0 4px;font-size:1.35rem}
    .channel-card p{margin:0;color:#dfeaf4}
    .channel-mark{width:62px;height:46px;display:grid;place-items:center;border-radius:12px;background:#e62117;font-size:1.35rem}
    @media(max-width:900px){.video-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:620px){.panel-heading{align-items:flex-start;flex-direction:column;gap:8px}.panel-heading a{white-space:normal}.video-grid{grid-template-columns:1fr}.instagram-feed{height:410px}}
  </style>
</Base>
