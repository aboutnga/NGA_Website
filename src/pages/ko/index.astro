---
import Base from '../../layouts/BaseLayout.astro';
---
<Base title="한국어 웹사이트 준비 중 | NGA">
  <section class="coming-soon">
    <div class="container panel">
      <img src="/images/brand/nga-circle.png" alt="NGA 차세대애드보켓츠 청소년재단"/>
      <p class="eyebrow">Korean Website</p>
      <h1>한국어 웹사이트<br/>준비 중입니다</h1>
      <p>더 나은 한국어 서비스로 곧 찾아뵙겠습니다.</p>
      <a class="btn btn-primary" href="/">English Website</a>
    </div>
  </section>
  <style>.coming-soon{min-height:70vh;display:grid;place-items:center;padding:72px 0;background:linear-gradient(135deg,var(--ivory),var(--blue-soft))}.panel{max-width:720px;text-align:center}.panel img{width:150px;margin:0 auto 24px}.panel h1{margin:10px 0 18px;font-family:var(--serif);font-size:clamp(2.6rem,7vw,4.5rem);line-height:1.15}.panel p:not(.eyebrow){margin:0 0 28px;color:var(--muted);font-size:1.15rem}</style>
</Base>
