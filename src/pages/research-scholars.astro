---
import Base from '../layouts/BaseLayout.astro';
---
<Base title="NGA Research Scholars Program" active="/programs">
  <section class="hero"><div class="hero-copy"><h1>NGA Research Scholars Program</h1><p>Mentor-guided. Student-led. Built for meaningful impact.</p></div><div class="hero-media"><img src="/images/generated/research-mentoring-hero.png" alt="Students collaborating on research with a mentor"/></div></section>
  <section class="statbar"><div class="stat"><strong>Grades 8–10</strong><span>New Students</span></div><div class="stat"><strong>Through Grade 12</strong><span>Continuing NGA Students</span></div></section>
  <section class="section"><div class="container"><h2 class="section-title">The Scholar Journey</h2><div class="rule"></div><div class="steps">{[['Discover','Hypothesis'],['Conduct','Research'],['Analyze &','Write'],['Communicate','Findings'],['Create Community','Impact']].map((lines,i)=><div class="step"><span class="number">{i+1}</span><strong>{lines[0]}<br/>{lines[1]}</strong></div>)}</div></div></section>
  <section class="section soft"><div class="container"><h2 class="section-title">What Scholars Develop</h2><div class="rule"></div><div class="grid skills">{['Research & Critical Thinking','Writing & Argumentation','Public Speaking & Dialogue','Digital & Project Skills','Master 9 Skill Sets'].map(x=><div class="colored-title">{x}</div>)}</div></div></section>
  <section class="section"><div class="container"><h2 class="section-title">Commitment and Expectations</h2><div class="rule"></div><div class="grid grid-4">{['Long-term Participation','Collaborative Work','Consistent Preparation','Projects to Completion'].map(x=><div class="card card-body center"><h3>{x}</h3></div>)}</div></div></section>
  <section class="section ivory"><div class="container"><h2 class="section-title">College Application Bootcamps for Enrolled Scholars</h2><div class="rule"></div><div class="grid grid-3">{['College List & Major Discovery','Personal Statements, Supplemental Essays & UC PIQs','College Application Process'].map(x=><div class="colored-title">{x}</div>)}</div><div class="notice"><h3>Applications Closed</h3><a class="btn btn-primary" href="https://forms.gle/UdxVedHorVtxEMDy5" target="_blank">Join the Inquiry List</a></div></div></section>
  <style>.skills{grid-template-columns:repeat(5,1fr)}.skills .colored-title{font-size:1.3rem}.notice{margin-top:28px;display:flex;align-items:center;justify-content:space-between;gap:20px}@media(max-width:900px){.skills{grid-template-columns:repeat(2,1fr)}.skills>div:last-child{grid-column:1/-1}}@media(max-width:620px){.notice{align-items:stretch;flex-direction:column}}</style>
</Base>
