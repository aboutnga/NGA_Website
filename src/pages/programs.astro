---
import Base from '../layouts/BaseLayout.astro';
const programs=[
  ['NGA Research Scholars Program','/research-scholars','Mentor-guided. Student-led.','research-mentoring-hero.png'],
  ['Community Impact Projects','/community-impact','Ideas transformed into practical initiatives.','community-impact-card.png'],
  ['NGA Scholar Talks','/scholar-talks','Student voices and original ideas.','scholar-talks-hero.png'],
  ['Meet a Mentor','/meet-a-mentor','Professional journeys and real-world insight.','meet-a-mentor-hero-banner-v4.png'],
  ['Daehan Heritage School','/daehan-heritage-school','Korean American history and cultural heritage education.','daehan-heritage-card.jpg'],
  ['NextGen Expo','/nextgen-expo','A showcase of youth-led organizations and ideas.','expo-card.jpg']
];
---
<Base title="Programs | Next Generation Advocates" active="/programs">
  <section class="page-banner"><div class="container"><h1>NGA Programs</h1><p>Research, communication, cultural heritage, professional exposure, and community impact.</p></div></section>
  <section class="section"><div class="container"><div class="grid grid-3">{programs.map(([name,href,copy,img])=><a class="program card" href={href}><img class={`photo ${name === 'Community Impact Projects' || name === 'Daehan Heritage School' ? 'photo--contain' : ''}`} src={`/images/generated/${img}`} alt={name === 'Community Impact Projects' ? 'Six featured NGA Community Impact Projects' : name === 'Daehan Heritage School' ? 'Daehan Heritage School students at their graduation ceremony' : name === 'NextGen Expo' ? 'Students and community partners gathered at the NGA Youth Expo' : ''}/><div class="card-body"><h3>{name}</h3><p>{copy}</p></div></a>)}</div></div></section>
  <style>.program{text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.program:hover{transform:translateY(-3px);box-shadow:var(--shadow)}.photo{width:100%;height:190px;object-fit:cover}.photo--contain{object-fit:contain;background:#fff}</style>
</Base>
