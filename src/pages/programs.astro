---
import Base from '../layouts/BaseLayout.astro';
const programs=[
  ['NGA Research Scholars Program','/research-scholars','Mentor-guided. Student-led.','research-mentoring-hero.png'],
  ['NGA Scholar Talks','/scholar-talks','Student voices and original ideas.','scholar-talks-hero.png'],
  ['Meet a Mentor','/meet-a-mentor','Professional journeys and real-world insight.','research-mentoring-hero.png'],
  ['Daehan Heritage School','/daehan-heritage-school','Korean American history and cultural heritage education.','heritage-hero.png'],
  ['Community Impact Projects','/community-impact','Ideas transformed into practical initiatives.','scholar-talks-hero.png'],
  ['NextGen Expo','/nextgen-expo','A showcase of youth-led organizations and ideas.','expo-hero.png']
];
---
<Base title="Programs | Next Generation Advocates" active="/programs">
  <section class="page-banner"><div class="container"><h1>NGA Programs</h1><p>Research, communication, cultural heritage, professional exposure, and community impact.</p></div></section>
  <section class="section"><div class="container"><div class="grid grid-3">{programs.map(([name,href,copy,img])=><a class="program card" href={href}><img class="photo" src={`/images/generated/${img}`} alt=""/><div class="card-body"><h3>{name}</h3><p>{copy}</p></div></a>)}</div></div></section>
  <style>.program{text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.program:hover{transform:translateY(-3px);box-shadow:var(--shadow)}.photo{width:100%;height:190px;object-fit:cover}</style>
</Base>
