---
import Base from '../layouts/BaseLayout.astro';
---
<Base title="Contact NGA" active="/contact"><section class="page-banner"><div class="container"><h1>Contact NGA</h1><p>Connect with Next Generation Advocates.</p></div></section><section class="section"><div class="container contact-grid"><article class="contact-info"><h2>Contact Information</h2><p><strong>Address</strong><br/>981 S. Western Ave., Suite 406<br/>Los Angeles, CA 90020<br/>By appointment only</p><p><strong>Phone</strong><br/><a href="tel:+14242535558">(424) 253-5558</a></p><p><strong>Email</strong><br/><a href="mailto:info@nextnga.org">info@nextnga.org</a></p><div class="actions"><a class="social instagram" href="https://www.instagram.com/next.generation.advocates/" target="_blank">Instagram</a><a class="social youtube" href="https://www.youtube.com/@nextNGA" target="_blank">YouTube</a></div></article><article class="form-panel"><h2>Questions or Program Interest?</h2><p>Use NGA’s inquiry form for general questions, program interest, and waiting-list requests.</p><a class="btn btn-primary" href="https://forms.gle/UdxVedHorVtxEMDy5" target="_blank">Open NGA Inquiry Form</a></article></div></section><style>.contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:38px;max-width:900px}.contact-info{padding:38px;color:#fff;background:var(--navy)}.contact-info h2,.form-panel h2{font-family:var(--serif);font-size:1.8rem}.contact-info a{color:#fff}.form-panel{display:flex;flex-direction:column;justify-content:center;padding:46px;border:1px solid var(--line)}.social{padding:10px 16px;color:#fff;text-decoration:none;font-weight:700}.instagram{background:var(--burgundy)}.youtube{background:#d92d2d}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}.form-panel{padding:32px}}</style></Base>
