---
import Base from '../layouts/BaseLayout.astro';
const programs=[['Research Scholars Program','Mentor-guided. Student-led.'],['Meet a Mentor','Professional journeys and real-world insight.'],['Daehan Heritage School','Korean American history and cultural heritage.']];
---
<Base title="Next Generation Advocates | Research with Purpose">
<section class="hero"><div class="hero-copy"><h1>Research with purpose.<br/>Ideas with impact.</h1><p>NGA Research Scholars turn curiosity into rigorous inquiry, public dialogue, and meaningful community impact.</p><div class="actions"><a class="btn btn-primary" href="/research-scholars">Explore the Scholars Program</a><a class="btn btn-secondary" href="https://forms.gle/UdxVedHorVtxEMDy5" target="_blank">Join the Inquiry List</a></div></div><div class="hero-media"><img src="/images/generated/research-mentoring-hero.png" alt="Students reviewing a research project with a mentor"/></div></section>
<section class="statbar"><div class="stat"><strong>2018</strong><span>Founded</span></div><div class="stat"><strong>120,000+</strong><span>Student Project Hours</span></div><div class="stat"><strong>24</strong><span>Community Impact Projects</span></div><div class="stat"><strong>8</strong><span>Mentors Hosted</span></div></section>
<section class="section"><div class="container"><h2 class="section-title">Pathways for Every Changemaker</h2><div class="rule"></div><div class="grid grid-3"><a class="card audience" href="/research-scholars"><div class="colored-title">For Parents</div><div class="card-body">Understand NGA’s long-term program, expectations, and student development.<span>Explore the program →</span></div></a><a class="card audience" href="/student-showcase"><div class="colored-title">For Students</div><div class="card-body">Explore big questions, develop ideas, and create meaningful impact.<span>View student work →</span></div></a><a class="card audience" href="/about#impact"><div class="colored-title">For Donors & Grantmakers</div><div class="card-body">Support research-informed youth initiatives and community impact.<span>Review NGA’s impact →</span></div></a></div></div></section>
<section class="section soft"><div class="container"><h2 class="section-title">NGA Programs</h2><div class="rule"></div><div class="grid grid-3">{programs.map(([name,copy],i)=><article class="card"><img class="program-photo" src={['/images/generated/research-mentoring-hero.png','/images/generated/scholar-talks-hero.png','/images/generated/heritage-hero.png'][i]} alt=""/><div class="card-body"><h3>{name}</h3><p>{copy}</p></div></article>)}</div><p class="center"><a class="btn btn-secondary" href="/programs">View All Programs</a></p></div></section>
<style>.audience{text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.audience:hover{transform:translateY(-3px);box-shadow:var(--shadow)}.audience span{display:block;margin-top:16px;color:var(--burgundy);font-weight:700}.program-photo{width:100%;height:190px;object-fit:cover}.hero-media img{object-fit:cover;object-position:center}@media(max-width:900px){.hero-media{min-height:0}.hero-media img{height:auto;min-height:0;object-fit:contain}}</style>
</Base>
