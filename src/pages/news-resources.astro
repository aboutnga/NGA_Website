---
import Base from '../layouts/BaseLayout.astro';

const fallbackNews = [
  { category: 'College Admissions', title: 'Important changes for the upcoming admissions cycle', source: 'College Board', published: '2026-08-15', url: 'https://newsroom.collegeboard.org/' },
  { category: 'Financial Aid', title: 'FAFSA application guidance and current deadlines', source: 'Federal Student Aid', published: '2026-08-13', url: 'https://studentaid.gov/' },
  { category: 'Scholarships', title: 'New scholarship opportunities for students', source: 'U.S. Department of Education', published: '2026-08-11', url: 'https://www.ed.gov/' },
  { category: 'Careers', title: 'Career outlook and workforce updates', source: 'Bureau of Labor Statistics', published: '2026-08-09', url: 'https://www.bls.gov/ooh/home.htm' },
  { category: 'Education', title: 'Federal education policy announcements', source: 'U.S. Department of Education', published: '2026-08-07', url: 'https://www.ed.gov/about/news/press-release' },
  { category: 'College Admissions', title: 'Resources for building a balanced college list', source: 'College Board', published: '2026-08-05', url: 'https://bigfuture.collegeboard.org/' }
];
---

<Base title="News & Resources | NGA" active="/news-resources">
  <section class="page-banner">
    <div class="container">
      <h1>News & Resources</h1>
      <p>Trusted updates on education, college admissions, financial aid, scholarships, and careers.</p>
    </div>
  </section>

  <section class="section latest-section">
    <div class="container">
      <h2 class="section-title">Latest Updates</h2>
      <div class="rule"></div>
      <p id="feed-status" class="feed-status" aria-live="polite">Automatically refreshed from trusted education sources.</p>

      <div class="news-layout">
        <div id="featured-news" class="featured-grid">
          {fallbackNews.slice(0, 3).map((item, index) =>
            <a class={`featured-card tone-${index}`} href={item.url} target="_blank" rel="noreferrer">
              <div class="featured-top"><span>{item.category}</span></div>
              <div class="featured-body">
                <h3>{item.title}</h3>
                <p>Read the latest update from {item.source}.</p>
                <small>{item.source} <time datetime={item.published}>{item.published}</time></small>
              </div>
            </a>
          )}
        </div>

        <aside class="latest-resources" aria-labelledby="latest-resources-title">
          <h2 id="latest-resources-title">Latest Resources</h2>
          <div id="latest-list">
            {fallbackNews.slice(0, 5).map((item, index) =>
              <a class="update" href={item.url} target="_blank" rel="noreferrer">
                <b>{index + 1}</b>
                <span><strong>{item.title}</strong><small>{item.source}</small></span>
              </a>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section soft all-news-section">
    <div class="container">
      <h2>All News &amp; Resources</h2>
      <div class="all-news-rule"></div>

      <div id="news-filters" class="categories" aria-label="Filter news and resources by category">
        {['All', 'Education', 'Admissions', 'Financial Aid', 'Scholarships', 'Careers'].map((label, index) =>
          <button type="button" class:list={{ active: index === 0 }} data-filter={label} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>
        )}
      </div>

      <label class="search-label" for="news-search">Search articles</label>
      <input id="news-search" class="news-search" type="search" placeholder="Search articles" autocomplete="off" />

      <div class="resource-table" role="table" aria-label="All news and resources">
        <div class="resource-row resource-head" role="row">
          <b role="columnheader">Category</b><b role="columnheader">Headline</b><b role="columnheader">Source</b><b role="columnheader">Date</b>
        </div>
        <div id="all-news-list">
          {fallbackNews.map((item) =>
            <a class="resource-row" role="row" href={item.url} target="_blank" rel="noreferrer">
              <span class="category-tag" data-category={item.category} role="cell">{item.category}</span><strong role="cell">{item.title}</strong><span role="cell">{item.source}</span><time role="cell" datetime={item.published}>{item.published}</time>
            </a>
          )}
        </div>
      </div>
      <p id="empty-news" class="empty-news" hidden>No articles match this search.</p>
    </div>
  </section>

  <script define:vars={{ fallbackNews }}>
    const featured = document.querySelector('#featured-news');
    const latestList = document.querySelector('#latest-list');
    const allNewsList = document.querySelector('#all-news-list');
    const status = document.querySelector('#feed-status');
    const search = document.querySelector('#news-search');
    const filterButtons = [...document.querySelectorAll('[data-filter]')];
    const emptyState = document.querySelector('#empty-news');
    let allItems = fallbackNews;
    let activeFilter = 'All';

    const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
    const formatDate = (value) => {
      if (!value) return 'Recent';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;
      return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
    };
    const matchesFilter = (category, filter) => {
      if (filter === 'All') return true;
      const normalized = category.toLowerCase();
      if (filter === 'Admissions') return normalized.includes('admission');
      if (filter === 'Education') return normalized.includes('education');
      if (filter === 'Careers') return normalized.includes('career');
      return normalized.includes(filter.toLowerCase());
    };

    const renderFeatured = (items) => {
      if (!(featured instanceof HTMLElement)) return;
      featured.innerHTML = items.slice(0, 3).map((item, index) => `
        <a class="featured-card tone-${index}" href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer">
          <div class="featured-top"><span>${escapeHtml(item.category)}</span></div>
          <div class="featured-body"><h3>${escapeHtml(item.title)}</h3><p>Read the latest update from ${escapeHtml(item.source)}.</p><small>${escapeHtml(item.source)} <time>${escapeHtml(formatDate(item.published))}</time></small></div>
        </a>`).join('');
    };

    const renderLatest = (items) => {
      if (!(latestList instanceof HTMLElement)) return;
      latestList.innerHTML = items.slice(0, 5).map((item, index) => `
        <a class="update" href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer"><b>${index + 1}</b><span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.source)}</small></span></a>`).join('');
    };

    const renderAll = () => {
      if (!(allNewsList instanceof HTMLElement)) return;
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      const visible = allItems.filter((item) => matchesFilter(item.category, activeFilter) && `${item.title} ${item.source} ${item.category}`.toLowerCase().includes(query));
      allNewsList.innerHTML = visible.map((item) => `
        <a class="resource-row" role="row" href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer"><span class="category-tag" data-category="${escapeHtml(item.category)}" role="cell">${escapeHtml(item.category)}</span><strong role="cell">${escapeHtml(item.title)}</strong><span role="cell">${escapeHtml(item.source)}</span><time role="cell">${escapeHtml(formatDate(item.published))}</time></a>`).join('');
      if (emptyState instanceof HTMLElement) emptyState.hidden = visible.length !== 0;
    };

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      activeFilter = button.dataset.filter || 'All';
      filterButtons.forEach((candidate) => {
        const selected = candidate === button;
        candidate.classList.toggle('active', selected);
        candidate.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      renderAll();
    }));
    search?.addEventListener('input', renderAll);

    fetch('/api/education-news')
      .then((response) => {
        if (!response.ok) throw new Error('Feed unavailable');
        return response.json();
      })
      .then((data) => {
        if (!Array.isArray(data.items) || !data.items.length) throw new Error('No updates');
        allItems = data.items;
        renderFeatured(allItems);
        renderLatest(allItems);
        renderAll();
        if (status instanceof HTMLElement) status.textContent = 'Automatically refreshed from trusted education sources.';
      })
      .catch(() => {
        if (status instanceof HTMLElement) status.textContent = 'Showing the saved resource collection. Live updates will return automatically.';
      });
  </script>

  <style is:global>
    .latest-section{padding-bottom:8px}
    .news-layout{display:grid;grid-template-columns:minmax(0,3fr) minmax(240px,1fr);gap:18px;align-items:stretch}
    .feed-status{margin:-18px 0 24px;color:var(--muted)}
    .featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .featured-card{overflow:hidden;color:var(--ink);background:#fff;border:1px solid var(--line);box-shadow:0 8px 25px rgba(16,42,76,.05);text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}
    .featured-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
    .featured-top{min-height:120px;display:flex;align-items:flex-end;padding:18px;color:#fff;background:#195495}
    .tone-1 .featured-top{background:#587a9b}.tone-2 .featured-top{background:#287f82}
    .featured-top span{padding:7px 11px;border-radius:18px;background:#102f52;font-size:.76rem;font-weight:700}
    .featured-body{padding:20px}
    .featured-body h3{margin:0 0 10px;font-family:var(--serif);font-size:1.18rem;line-height:1.3}
    .featured-body p{margin:0 0 22px;color:var(--muted)}
    .featured-body small{display:flex;justify-content:space-between;gap:12px;color:var(--muted)}
    .latest-resources{min-height:0;display:flex;flex-direction:column;padding:8px;background:#fff;border:1px solid var(--line);box-shadow:0 8px 25px rgba(16,42,76,.05)}
    .latest-resources h2{margin:0 0 3px;font-family:var(--serif);font-size:.9rem;line-height:1.15}
    #latest-list{display:flex;min-height:0;flex:1;flex-direction:column}
    .update{display:flex;min-height:0;flex:1;align-items:center;gap:6px;padding:2px 0;color:var(--ink);border-bottom:1px solid var(--line);text-decoration:none}
    .update b{width:20px;height:20px;display:grid;flex:0 0 20px;place-items:center;border-radius:2px;color:#fff;background:var(--burgundy);font-size:.68rem}
    .update span,.update small{display:block}.update strong{font-size:.68rem;line-height:1.16}.update small{margin-top:1px;color:var(--muted);font-size:.6rem;line-height:1.12}
    .all-news-section{padding-top:12px}
    .all-news-section h2{margin:0;font-family:var(--serif);font-size:1.8rem}
    .all-news-rule{height:2px;margin:12px 0 18px;background:var(--navy)}
    .categories{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
    .categories button{padding:7px 12px;border:1px solid var(--line);border-radius:18px;color:var(--ink);background:#fff;cursor:pointer;font:inherit}
    .categories button.active{color:#fff;background:var(--navy);border-color:var(--navy)}
    .search-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
    .news-search{width:100%;margin-bottom:16px;padding:10px 14px;border:1px solid var(--line);border-radius:7px;font:inherit}
    .resource-table{border-top:1px solid var(--line)}
    .resource-row{display:grid;grid-template-columns:1.1fr 3.2fr 1.7fr 1fr;gap:16px;padding:15px 10px;color:var(--ink);border-bottom:1px solid var(--line);text-decoration:none;font-size:.92rem}
    .resource-row strong{font-weight:600}.resource-row time{text-align:right;color:var(--muted)}
    .resource-head{color:var(--muted);background:#fff;font-size:.82rem}
    .empty-news{padding:28px;text-align:center;color:var(--muted)}
    @media(max-width:980px){.news-layout{grid-template-columns:1fr}.latest-resources{height:auto;padding:18px}.latest-resources h2{font-size:1.35rem}.update{padding:10px 0}.update strong{font-size:.95rem}.update small{font-size:.82rem}.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:700px){.featured-grid{grid-template-columns:1fr}.resource-head{display:none}.resource-row{grid-template-columns:1fr;gap:5px;padding:18px 12px}.resource-row time{text-align:left}.feed-status{margin-top:-10px}.all-news-section h2{font-size:1.6rem}}
  </style>

  <style is:inline>
    .category-tag{width:max-content;max-width:100%;align-self:center;padding:5px 9px;border:1px solid rgba(16,42,76,.08);border-radius:14px;color:var(--navy);background:#f5e784;font-size:.875rem;font-weight:700;line-height:1.2}
    .category-tag[data-category="Education & Careers"]{background:#f58b83}
    .category-tag[data-category="College Admissions"]{background:#84b8e8}
    .category-tag[data-category="Financial Aid"]{background:#b89cc8}
    .category-tag[data-category="Scholarships"]{background:#8fd3c2}
    .category-tag[data-category="Careers"]{background:#ffa17f}
    .category-tag[data-category="Education"]{background:#f5e784}
  </style>
</Base>
