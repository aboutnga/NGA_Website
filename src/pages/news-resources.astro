---
import Base from '../layouts/BaseLayout.astro';

const trustedSources = [
  ['College Admissions', 'College Board Newsroom', 'Current admissions, SAT, AP, and scholarship announcements.', 'https://newsroom.collegeboard.org/'],
  ['Financial Aid', 'Federal Student Aid', 'Official FAFSA news, deadlines, and financial-aid guidance.', 'https://financialaidtoolkit.ed.gov/tk/learn/fafsa/updates.jsp'],
  ['Career Exploration', 'Occupational Outlook Handbook', 'Current career requirements, pay, and employment outlook.', 'https://www.bls.gov/ooh/home.htm']
];
---

<Base title="News & Resources | NGA" active="/news-resources">
  <section class="page-banner">
    <div class="container">
      <h1>News & Resources</h1>
      <p>Live updates on education, college admissions, financial aid, scholarships, and careers.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feed-title-row">
        <div>
          <h2 class="section-title">Educational News</h2>
          <p id="feed-status" class="feed-status" aria-live="polite">Loading the latest trusted updates…</p>
        </div>
        <a class="channel-link" href="/student-showcase">See NGA’s social feeds →</a>
      </div>
      <div class="rule left"></div>

      <div id="news-feed" class="news-grid" aria-live="polite"></div>

      <div id="source-fallback" class="source-grid">
        {trustedSources.map(([category, name, description, url]) =>
          <a class="source-card" href={url} target="_blank" rel="noreferrer">
            <span>{category}</span>
            <h3>{name}</h3>
            <p>{description}</p>
            <strong>Visit official source →</strong>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2>Trusted Resource Library</h2>
      <p class="resource-intro">These official sources remain available even when a live feed is temporarily unavailable.</p>
      <div class="resource-links">
        <a href="https://www.ed.gov/about/news/press-release" target="_blank" rel="noreferrer">U.S. Department of Education</a>
        <a href="https://studentaid.gov/" target="_blank" rel="noreferrer">Federal Student Aid</a>
        <a href="https://newsroom.collegeboard.org/" target="_blank" rel="noreferrer">College Board Newsroom</a>
        <a href="https://www.bls.gov/ooh/home.htm" target="_blank" rel="noreferrer">Occupational Outlook Handbook</a>
      </div>
    </div>
  </section>

  <script>
    const feed = document.querySelector('#news-feed');
    const status = document.querySelector('#feed-status');
    const fallback = document.querySelector('#source-fallback');

    const formatDate = (value) => {
      if (!value) return 'Recent update';
      return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value));
    };

    const renderNews = (items) => {
      if (!(feed instanceof HTMLElement)) return;

      items.forEach((item) => {
        const link = document.createElement('a');
        link.className = 'news-card';
        link.href = item.url;
        link.target = '_blank';
        link.rel = 'noreferrer';

        const category = document.createElement('span');
        category.className = 'news-category';
        category.textContent = item.category;

        const title = document.createElement('h3');
        title.textContent = item.title;

        const details = document.createElement('p');
        details.textContent = `${item.source} · ${formatDate(item.published)}`;

        const action = document.createElement('strong');
        action.textContent = 'Read update →';

        link.append(category, title, details, action);
        feed.append(link);
      });
    };

    fetch('/api/education-news')
      .then((response) => {
        if (!response.ok) throw new Error('Feed unavailable');
        return response.json();
      })
      .then((data) => {
        if (!Array.isArray(data.items) || !data.items.length) throw new Error('No updates');
        renderNews(data.items);
        if (fallback instanceof HTMLElement) fallback.hidden = true;
        if (status instanceof HTMLElement) status.textContent = 'Automatically refreshed from trusted education sources.';
      })
      .catch(() => {
        if (status instanceof HTMLElement) status.textContent = 'Official resource links are shown below. Live updates will return automatically.';
      });
  </script>

  <style>
    .feed-title-row{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
    .feed-title-row .section-title{text-align:left}
    .feed-status{margin:6px 0 0;color:var(--muted)}
    .rule.left{margin:18px 0 34px}
    .channel-link{color:var(--burgundy);font-weight:700;text-decoration:none;white-space:nowrap}
    .news-grid,.source-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
    .news-card,.source-card{display:flex;min-height:245px;flex-direction:column;padding:24px;color:var(--ink);background:#fff;border:1px solid var(--line);box-shadow:0 8px 25px rgba(16,42,76,.05);text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}
    .news-card:hover,.source-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
    .news-card h3,.source-card h3{margin:12px 0 10px;font-family:var(--serif);font-size:1.3rem;line-height:1.3}
    .news-card p,.source-card p{margin:0 0 20px;color:var(--muted)}
    .news-card strong,.source-card strong{margin-top:auto;color:var(--burgundy)}
    .news-category,.source-card>span{color:var(--burgundy);font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .resource-intro{margin-top:0;color:var(--muted)}
    .resource-links{display:flex;flex-wrap:wrap;gap:12px}
    .resource-links a{padding:11px 15px;background:#fff;border:1px solid var(--line);text-decoration:none;font-weight:700}
    @media(max-width:900px){.news-grid,.source-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:620px){.feed-title-row{align-items:flex-start;flex-direction:column}.news-grid,.source-grid{grid-template-columns:1fr}.channel-link{white-space:normal}}
  </style>
</Base>
