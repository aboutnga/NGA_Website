---
import Base from '../layouts/BaseLayout.astro';
const updates=[['Admissions-cycle update','College Board'],['FAFSA guidance and deadlines','Federal Student Aid'],['CSS Profile information','College Board'],['Education-policy announcement','U.S. Department of Education'],['Career and workforce update','Bureau of Labor Statistics']];
---
<Base title="News & Resources | NGA" active="/news-resources"><section class="page-banner"><div class="container"><h1>News & Resources</h1><p>Trusted updates on education, college admissions, financial aid, scholarships, and careers.</p></div></section><section class="section"><div class="container news-layout"><div><h2 class="section-title">Educational News</h2><div class="rule"></div><div class="grid grid-3">{[['College Admissions','Pinned educational news headline'],['Financial Aid','Pinned financial-aid update'],['Scholarships','Pinned scholarship opportunity']].map(([cat,title],i)=><article class="card"><div class={`news-top n${i}`}>{cat}</div><div class="card-body"><h3>{title}</h3><p>Short Korean summary will appear here.</p><small>Authoritative source · Date</small></div></article>)}</div><section class="insights"><h2>NGA Insights</h2><div class="grid grid-2"><article class="insight"><strong>NGA ARTICLE</strong><div><span>Original Article</span><h3>Article title will appear here</h3><small>By Founder, Helen Kim</small></div></article><article class="insight"><strong>NGA VIDEO</strong><div><span>Video / YouTube</span><h3>Video title will appear here</h3><small>By Founder, Helen Kim</small></div></article></div></section></div><aside><h2>Latest Updates</h2>{updates.map(([title,source],i)=><div class="update"><b>{i+1}</b><span><strong>{title}</strong><small>{source}</small></span></div>)}</aside></div></section><section class="section soft"><div class="container"><h2>All News & Resources</h2><div class="categories"><span>All</span><span>Education</span><span>Admissions</span><span>Financial Aid</span><span>Scholarships</span><span>Careers</span></div><div class="resource-row"><b>Category</b><b>Headline</b><b>Source</b><b>Date</b></div>{updates.map(([title,source])=><div class="resource-row"><span>Education</span><span>{title}</span><span>{source}</span><span>Date</span></div>)}</div></section><style>.news-layout{display:grid;grid-template-columns:minmax(0,3fr) minmax(230px,1fr);gap:32px}.news-top{min-height:120px;display:flex;align-items:flex-end;padding:18px;color:#fff;background:var(--navy);font-size:.75rem;font-weight:700;text-transform:uppercase}.n1{background:var(--slate)}.n2{background:#287f82}.update{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}.update b{width:28px;height:28px;display:grid;place-items:center;color:#fff;background:var(--burgundy)}.update span,.update small{display:block}.insights{margin-top:34px}.insight{display:grid;grid-template-columns:135px 1fr;min-height:150px;border:1px solid var(--line);background:#fff}.insight>strong{display:grid;place-items:center;padding:16px;color:#fff;background:var(--burgundy)}.insight:nth-child(2)>strong{background:var(--navy)}.insight>div{padding:20px}.insight h3{margin:5px 0;font-family:var(--serif)}.categories{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.categories span{padding:7px 12px;border:1px solid var(--line);background:#fff}.resource-row{display:grid;grid-template-columns:1fr 3fr 1.5fr .7fr;gap:16px;padding:13px 8px;border-bottom:1px solid var(--line);font-size:.9rem}@media(max-width:850px){.news-layout{grid-template-columns:1fr}.resource-row{grid-template-columns:1fr}.resource-row>*:nth-child(3),.resource-row>*:nth-child(4){color:var(--muted)}}@media(max-width:620px){.insight{grid-template-columns:100px 1fr}}</style></Base>
