---
import Base from '../layouts/BaseLayout.astro';
---
<Base title="Daehan Heritage School | NGA" active="/programs">
  <section class="hero"><div class="hero-copy"><h1>Daehan Heritage School</h1><p>Korean American history, the Korean independence movement in the United States, and cultural heritage education.</p></div><div class="hero-media"><img src="/images/generated/heritage-hero.png" alt="Students examining historical photographs and archival materials"/></div></section>
  <section class="section"><div class="container"><h2 class="section-title">Program Purpose</h2><div class="rule"></div><div class="grid grid-4">{['History','Identity','Heritage','Civic Engagement'].map(x=><div class="colored-title">{x}</div>)}</div></div></section>
  <section class="section soft"><div class="container"><h2 class="section-title">How Students Learn</h2><div class="rule"></div><div class="grid grid-4">{['Archival Research','Discussion & Dialogue','Storytelling & Media','Community Connection'].map(x=><div class="card card-body center"><h3>{x}</h3></div>)}</div></div></section>
  <section class="section"><div class="container"><h2 class="section-title">Program Highlights</h2><div class="rule"></div><div class="grid grid-3">{[1,2,3].map((n)=><div class="card"><img class={`highlight h${n}`} src="/images/generated/heritage-hero.png" alt="Students exploring Korean American heritage"/><div class="card-body center"><h3>Program Highlight</h3></div></div>)}</div></div></section>
  <style>.highlight{width:100%;height:190px;object-fit:cover}.h1{object-position:35% center}.h2{object-position:65% center}.h3{object-position:90% center}</style>
</Base>
