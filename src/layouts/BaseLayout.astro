---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title='Next Generation Advocates', description='Next Generation Advocates empowers students through research, communication, and community impact.', active='' }=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="generator" content={Astro.generator}/><title>{title}</title></head><body><a class="skip" href="#main">Skip to content</a><Header active={active}/><main id="main"><slot/></main><Footer/></body></html>
<style>.skip{position:absolute;left:-999px;top:8px;z-index:100;padding:10px;color:#fff;background:var(--burgundy)}.skip:focus{left:8px}</style>
