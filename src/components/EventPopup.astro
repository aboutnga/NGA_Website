---
const registrationOpen = true;
const registrationUrl = 'https://forms.gle/cK2QJrfFRGDjBqhKA';
---

{registrationOpen && (
  <dialog
    class="event-popup"
    id="meet-a-mentor-popup"
    aria-labelledby="event-popup-title"
    data-expires="2026-09-20T00:00:00-07:00"
  >
    <div class="event-popup__panel">
      <button class="event-popup__close" type="button" aria-label="Close event announcement">×</button>
      <div class="event-popup__flyer">
        <img
          src="/images/events/meet-a-mentor-10.jpg"
          alt="Meet a Mentor number 10: Careers in LA Fire Department, September 19, 2026 from 10 AM to 2 PM at KAFLA Hall"
        />
      </div>
      <div class="event-popup__details">
        <span class="eyebrow">Upcoming Event</span>
        <h2 id="event-popup-title">Meet a Mentor #10</h2>
        <p class="event-popup__topic">Careers in LA Fire Department</p>
        <dl>
          <div><dt>Date · 날짜</dt><dd>Saturday, September 19, 2026</dd></div>
          <div><dt>Time · 시간</dt><dd>10:00 AM–2:00 PM</dd></div>
          <div><dt>Mentor · 멘토</dt><dd>Jason Phillips, Los Angeles Fire Department</dd></div>
          <div class="event-popup__parking">
            <dt>Free All-Day Parking · 무료 종일 주차</dt>
            <dd>
              <strong>KTP · Koreatown Plaza</strong><br/>
              928 S. Western Ave., Los Angeles, CA 90006
              <span class="event-popup__parking-note">Bring your parking ticket for validation.<br/><span lang="ko">주차권 꼭 가지고 오셔야 합니다.</span></span>
            </dd>
          </div>
        </dl>
        <p class="event-popup__note">Parents and students must attend together.<br/><span lang="ko">부모와 학생이 반드시 함께 참석해야 합니다.</span></p>
        <a class="event-popup__register" href={registrationUrl} target="_blank" rel="noreferrer">
          Register · 등록하기
        </a>
        <button class="event-popup__later" type="button">Not now · 나중에</button>
      </div>
    </div>
  </dialog>
)}

<script>
  const popup = document.querySelector<HTMLDialogElement>('#meet-a-mentor-popup');
  const dismissKey = 'nga-meet-a-mentor-10-dismissed';

  if (popup) {
    const preview = new URLSearchParams(window.location.search).get('event-popup') === 'preview';
    const expires = new Date(popup.dataset.expires ?? '').getTime();
    const registrationActive = Number.isFinite(expires) && Date.now() < expires;
    const dismissed = sessionStorage.getItem(dismissKey) === 'true';

    if (preview || (registrationActive && !dismissed)) popup.showModal();

    const closePopup = () => {
      popup.close();
      if (!preview) sessionStorage.setItem(dismissKey, 'true');
    };

    popup.querySelector('.event-popup__close')?.addEventListener('click', closePopup);
    popup.querySelector('.event-popup__later')?.addEventListener('click', closePopup);
    popup.addEventListener('click', (event) => {
      if (event.target === popup) closePopup();
    });
  }
</script>

<style>
  .event-popup{width:min(1040px,calc(100% - 32px));max-height:92vh;padding:0;color:var(--ink);background:#fff;border:0;border-radius:10px;box-shadow:0 28px 90px rgba(4,19,40,.38);overflow:auto}
  .event-popup::backdrop{background:rgba(10,28,52,.76);backdrop-filter:blur(3px)}
  .event-popup__panel{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr)}
  .event-popup__close{position:absolute;z-index:2;top:12px;right:12px;width:42px;height:42px;padding:0;color:var(--navy);background:rgba(255,255,255,.94);border:1px solid var(--line);border-radius:50%;font-size:1.8rem;line-height:1;cursor:pointer;box-shadow:0 3px 14px rgba(16,42,76,.16)}
  .event-popup__flyer{display:grid;align-items:center;padding:20px;background:#e9f1ff}
  .event-popup__flyer img{width:100%;max-height:calc(92vh - 40px);object-fit:contain;box-shadow:0 10px 28px rgba(16,42,76,.14)}
  .event-popup__details{display:flex;flex-direction:column;justify-content:center;padding:40px 36px 24px;background:#fff}
  .event-popup__details h2{margin:8px 0 2px;color:var(--navy);font-family:var(--serif);font-size:clamp(2rem,3vw,2.8rem);line-height:1.08}
  .event-popup__topic{margin:0 0 16px;color:var(--burgundy);font-size:1.28rem;font-weight:700;line-height:1.3}
  .event-popup__details dl{display:grid;gap:8px;margin:0 0 14px}
  .event-popup__details dl div{padding-bottom:7px;border-bottom:1px solid var(--line)}
  .event-popup__details dt{color:var(--navy);font-size:.78rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
  .event-popup__details dd{margin:2px 0 0;font-size:.97rem;line-height:1.45}
  .event-popup__details .event-popup__parking{margin-top:2px;padding:10px 12px;border:2px solid #f2bf42;border-radius:5px;background:#fff4c7}
  .event-popup__details .event-popup__parking dt{color:#8d283d;font-size:.9rem;letter-spacing:.025em}
  .event-popup__details .event-popup__parking dd{color:var(--navy)}
  .event-popup__parking-note{display:block;margin-top:6px;color:#8d283d;font-size:.82rem;font-weight:700;line-height:1.35}
  .event-popup__note{margin:0 0 14px;color:var(--muted);font-size:.9rem;line-height:1.45}
  .event-popup__register{display:flex;min-height:52px;align-items:center;justify-content:center;padding:13px 20px;color:#fff;background:var(--burgundy);border-radius:4px;text-decoration:none;font-size:1.05rem;font-weight:700}
  .event-popup__register:hover{background:#84273a}
  .event-popup__later{align-self:center;margin-top:12px;padding:6px 10px;color:var(--muted);background:transparent;border:0;text-decoration:underline;cursor:pointer}
  @media(min-width:1000px){.event-popup__details h2{font-size:2.35rem;white-space:nowrap}}
  @media(max-width:760px){
    .event-popup{width:min(94vw,560px);max-height:94vh}
    .event-popup__panel{grid-template-columns:1fr}
    .event-popup__flyer{padding:12px}
    .event-popup__flyer img{max-height:none}
    .event-popup__details{padding:30px 24px 26px}
    .event-popup__details h2{font-size:2rem}
    .event-popup__close{position:fixed;top:max(12px,env(safe-area-inset-top));right:calc(3vw + 12px)}
  }
</style>
