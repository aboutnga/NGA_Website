---
const { active = '' } = Astro.props;
const nav = [
  ['About NGA','/about'],['Programs','/programs'],['Community Impact','/community-impact'],
  ['News & Resources','/news-resources'],['Student Showcase','/student-showcase'],['Contact','/contact']
];
---
<div class="utility"><div class="container">English <span>|</span> <a href="/ko/">한국어</a></div></div>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Next Generation Advocates home">
      <img class="brand-circle" src="/images/brand/nga-circle.png" alt=""/>
      <span class="brand-copy">
        <strong>Next Generation Advocates</strong>
        <small>NGA 차세대애드보켓츠</small>
        <small>청소년재단</small>
      </span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu">Menu</button>
    <nav id="site-menu" aria-label="Primary navigation">
      {nav.map(([label,href]) => <a class={active === href ? 'active' : ''} href={href}>{label}</a>)}
    </nav>
  </div>
</header>
<script>
  const button=document.querySelector('.menu-button'); const menu=document.querySelector('#site-menu');
  button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));menu?.classList.toggle('open',!open)});
</script>
<style>
.utility{padding:7px 0;text-align:right;color:#fff;background:var(--navy);font-size:.78rem}.utility span{margin:0 8px}.site-header{position:relative;z-index:20;background:#fff;border-bottom:1px solid var(--line)}.header-inner{min-height:104px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:14px;text-decoration:none}.brand-circle{width:78px;height:78px;flex:0 0 auto;object-fit:contain}.brand-copy,.brand-copy strong,.brand-copy small{display:block}.brand-copy strong{color:var(--navy);font-size:1.14rem;line-height:1.15}.brand-copy small{margin-top:3px;color:#577294;font-size:.78rem;line-height:1.15}.site-header nav{display:flex;align-items:center;gap:22px}.site-header nav a{padding:31px 0 7px;text-decoration:none;font-size:.84rem;border-bottom:2px solid transparent}.site-header nav a:hover,.site-header nav a.active{color:var(--burgundy);border-color:var(--burgundy)}.menu-button{display:none;padding:10px 13px;color:var(--navy);background:#fff;border:1px solid var(--line)}@media(max-width:1100px){.brand-circle{width:68px;height:68px}.brand-copy strong{font-size:.98rem}.brand-copy small{font-size:.68rem}.site-header nav{gap:14px}.site-header nav a{font-size:.76rem}}@media(max-width:900px){.header-inner{min-height:78px;gap:12px}.menu-button{display:block;flex:0 0 auto}.site-header nav{display:none;position:absolute;top:100%;left:0;right:0;padding:16px 5%;background:#fff;border-bottom:1px solid var(--line);box-shadow:var(--shadow)}.site-header nav.open{display:grid}.site-header nav a{padding:12px 0}.brand{gap:9px}.brand-circle{width:56px;height:56px}.brand-copy strong{font-size:.82rem}.brand-copy small{margin-top:2px;font-size:.58rem}}@media(max-width:430px){.brand-circle{width:48px;height:48px}.brand-copy strong{font-size:.7rem}.brand-copy small{font-size:.5rem}.menu-button{padding:9px 10px}}
</style>
